{
  "to_controller_type": "alvr_vrx_controller",
  "layouts": [
    {
      "priority": 100,
      "from_controller_type": "oculus_touch",
      "simulate_controller_type": false,
      "simulate_render_model": false,
      "simulate_HMD": false,
      "autoremappings": [
        {"from": "/user/hand/right/input/trigger", "to": "/user/hand/right/input/trigger"},
        {"from": "/user/hand/right/input/grip", "to": "/user/hand/right/input/grip"},
        {"from": "/user/hand/right/input/joystick", "to": "/user/hand/right/input/joystick"}
      ],
      "remappings": [
        {"from": {"path": "/user/hand/right/input/thumbrest"}, "remapping_mode": "delete"},
        {"from": {"path": "/user/hand/right/pose/openxr_aim"}, "to": {"path": "/user/hand/right/pose/openxr_aim"}},
        {"from": {"path": "/user/hand/right/pose/openxr_grip"}, "to": {"path": "/user/hand/right/pose/openxr_grip"}}
      ]
    }
  ]
}
